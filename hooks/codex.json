{
  "description": "Record native tool paths, check changed repositories at Stop, and restore agreed context after compaction.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash|PowerShell|exec_command|shell_command|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/compact_anchor_codex.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/compact_anchor_codex.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|exec_command|shell_command|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/doc_gate_codex.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/compact_anchor_codex.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/compact_anchor_codex.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/compact_anchor_codex.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/compact_anchor_codex.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
